<?xml version="1.0"?>
<sdf version="1.9">
  <world name="stage4">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <!-- Preserve 1 ms integration / 1 kHz IMU fidelity, but compute at
           half wall-clock speed to avoid monopolising a CPU core. -->
      <real_time_factor>0.5</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <gravity>0 0 -9.80665</gravity>
    <scene>
      <ambient>0.8 0.8 0.8 1</ambient>
      <background>0.65 0.78 0.9 1</background>
      <shadows>false</shadows>
    </scene>
    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose><direction>-0.4 0.2 -1</direction>
      <diffuse>1 1 1 1</diffuse><specular>0.25 0.25 0.25 1</specular>
      <cast_shadows>false</cast_shadows>
    </light>
    <model name="ground"><static>true</static><link name="link"><collision name="c"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision><visual name="v"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry><material><ambient>0.72 0.72 0.72 1</ambient><diffuse>0.82 0.82 0.82 1</diffuse><specular>0.05 0.05 0.05 1</specular></material></visual></link></model>
    <!-- Inner faces form the same 10 x 8 m known map used by field.yaml. -->
    <model name="walls"><static>true</static><link name="link">
      <collision name="north"><pose>0 4.1 0.5 0 0 0</pose><geometry><box><size>10.2 0.2 1</size></box></geometry></collision>
      <collision name="south"><pose>0 -4.1 0.5 0 0 0</pose><geometry><box><size>10.2 0.2 1</size></box></geometry></collision>
      <collision name="east"><pose>5.1 0 0.5 0 0 0</pose><geometry><box><size>0.2 8 1</size></box></geometry></collision>
      <collision name="west"><pose>-5.1 0 0.5 0 0 0</pose><geometry><box><size>0.2 8 1</size></box></geometry></collision>
      <visual name="nv"><pose>0 4.1 0.5 0 0 0</pose><geometry><box><size>10.2 0.2 1</size></box></geometry><material><ambient>0.85 0.85 0.88 1</ambient><diffuse>0.95 0.95 0.98 1</diffuse></material></visual>
      <visual name="sv"><pose>0 -4.1 0.5 0 0 0</pose><geometry><box><size>10.2 0.2 1</size></box></geometry><material><ambient>0.85 0.85 0.88 1</ambient><diffuse>0.95 0.95 0.98 1</diffuse></material></visual>
      <visual name="ev"><pose>5.1 0 0.5 0 0 0</pose><geometry><box><size>0.2 8 1</size></box></geometry><material><ambient>0.85 0.85 0.88 1</ambient><diffuse>0.95 0.95 0.98 1</diffuse></material></visual>
      <visual name="wv"><pose>-5.1 0 0.5 0 0 0</pose><geometry><box><size>0.2 8 1</size></box></geometry><material><ambient>0.85 0.85 0.88 1</ambient><diffuse>0.95 0.95 0.98 1</diffuse></material></visual>
    </link></model>
    <model name="cylinder0"><static>true</static><pose>3 1.5 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><cylinder><radius>0.1</radius><length>1</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.1</radius><length>1</length></cylinder></geometry><material><ambient>0.05 0.55 0.15 1</ambient><diffuse>0.1 0.9 0.25 1</diffuse></material></visual></link></model>
    <model name="cylinder1"><static>true</static><pose>-1 -2.5 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><cylinder><radius>0.1</radius><length>1</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.1</radius><length>1</length></cylinder></geometry><material><ambient>0.55 0.05 0.08 1</ambient><diffuse>0.95 0.12 0.15 1</diffuse></material></visual></link></model>
    <model name="robot"><pose>0 0 0.16 0 0 0</pose><link name="base_link">
      <inertial><mass>18</mass><inertia><ixx>0.25</ixx><iyy>0.25</iyy><izz>0.4</izz></inertia></inertial>
      <collision name="body_collision"><geometry><box><size>0.5 0.42 0.22</size></box></geometry></collision><visual name="body_visual"><geometry><box><size>0.5 0.42 0.22</size></box></geometry><material><ambient>0.8 0.28 0.02 1</ambient><diffuse>1 0.42 0.04 1</diffuse><specular>0.3 0.3 0.3 1</specular></material></visual>
      <sensor name="imu" type="imu"><topic>/imu/data</topic><update_rate>1000</update_rate><always_on>true</always_on></sensor>
      <sensor name="lidar" type="gpu_lidar"><pose>0 0 0.16 0 0 0</pose><topic>/scan</topic><update_rate>40</update_rate><always_on>true</always_on><lidar><scan><horizontal><samples>1080</samples><resolution>1</resolution><min_angle>-2.35619449</min_angle><max_angle>2.35619449</max_angle></horizontal></scan><range><min>0.1</min><max>30</max><resolution>0.001</resolution></range><noise><type>gaussian</type><mean>0</mean><stddev>0.03</stddev></noise></lidar></sensor>
    </link>
    <link name="left_wheel"><pose>0 0.25 0 1.5708 0 0</pose><inertial><mass>1</mass><inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz></inertia></inertial><collision name="c"><geometry><cylinder><radius>0.10</radius><length>0.04</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.10</radius><length>0.04</length></cylinder></geometry><material><ambient>0.02 0.15 0.5 1</ambient><diffuse>0.04 0.3 0.95 1</diffuse></material></visual></link>
    <link name="right_wheel"><pose>0 -0.25 0 1.5708 0 0</pose><inertial><mass>1</mass><inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz></inertia></inertial><collision name="c"><geometry><cylinder><radius>0.10</radius><length>0.04</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.10</radius><length>0.04</length></cylinder></geometry><material><ambient>0.02 0.15 0.5 1</ambient><diffuse>0.04 0.3 0.95 1</diffuse></material></visual></link>
    <joint name="left_joint" type="revolute">
      <parent>base_link</parent><child>left_wheel</child>
      <!-- Joint origin and axis are expressed in the wheel frame.  The
           cylinder's local Z axis is its axle, so it spins in place instead
           of orbiting around the model origin. -->
      <pose relative_to="left_wheel">0 0 0 0 0 0</pose>
      <axis><xyz expressed_in="left_wheel">0 0 1</xyz></axis>
    </joint>
    <joint name="right_joint" type="revolute">
      <parent>base_link</parent><child>right_wheel</child>
      <pose relative_to="right_wheel">0 0 0 0 0 0</pose>
      <axis><xyz expressed_in="right_wheel">0 0 1</xyz></axis>
    </joint>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive"><left_joint>left_joint</left_joint><right_joint>right_joint</right_joint><wheel_separation>0.5</wheel_separation><wheel_radius>0.1</wheel_radius><topic>/cmd_vel</topic></plugin>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher"><odom_topic>/ground_truth_pose</odom_topic><odom_frame>map</odom_frame><robot_base_frame>base_link</robot_base_frame><dimensions>2</dimensions><odom_publish_frequency>100</odom_publish_frequency></plugin>
    </model>
  </world>
</sdf>
