diff --git a/src/imu_preintegration_node.cpp b/src/imu_preintegration_node.cpp
index b5bedfd..15383ba 100644
--- a/src/imu_preintegration_node.cpp
+++ b/src/imu_preintegration_node.cpp
@@ -323,8 +323,16 @@ void ImuPreintegrationNode::publish_odom(const rclcpp::Time & /*stamp*/)
   odom.pose.pose.orientation.z = q.z();
   odom.pose.pose.orientation.w = q.w();
 
-  odom.twist.twist.linear.x = vel.x();
-  odom.twist.twist.linear.y = vel.y();
+  // vel(=predicted.velocity())はGTSAM NavStateの規約でワールド座標系。
+  // nav_msgs/Odometryのtwistはchild_frame_id(=base_link)、すなわちボディ
+  // 座標系であるべき(Unity側UnityRosSensorPublisher.OnOdomFastReceivedも
+  // 「twistはボディ座標系」を前提にヨーで回転しワールド座標へ戻している)。
+  // yaw=0では回転が恒等変換になり無症状だったため、実旋回を初めて有効化する
+  // まで発見されなかった(2026-07-30)。ヨーの逆回転でボディ座標系へ変換する。
+  const double cos_yaw = std::cos(yaw);
+  const double sin_yaw = std::sin(yaw);
+  odom.twist.twist.linear.x = cos_yaw * vel.x() + sin_yaw * vel.y();
+  odom.twist.twist.linear.y = -sin_yaw * vel.x() + cos_yaw * vel.y();
   odom.twist.twist.linear.z = 0.0;
 
   odom_pub_->publish(odom);
