+    child_pid=""
+    forward_signal() {
+      [ -n "$child_pid" ] && kill "-$1" "$child_pid" 2>/dev/null || true
+    }
+    trap 'forward_signal INT' INT
+    trap 'forward_signal TERM' TERM
+    while true; do
+      "$@" &
+      child_pid=$!
