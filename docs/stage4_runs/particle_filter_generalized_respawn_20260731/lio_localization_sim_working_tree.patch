+      rc=$?
+      if [ "$rc" -ne 42 ]; then
+        exit "$rc"
+      fi
+      echo "[respawn] backend exited 42 (particle relocalization handoff): restarting immediately"
+    done
+  ) > "$OUT/$log" 2>&1 &
