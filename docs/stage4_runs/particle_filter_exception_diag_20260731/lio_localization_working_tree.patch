+bool LaserScanMatchingNode::step_particle_relocalization(
+  const Pose2D & odom_pose_now,
+  const std::vector<Eigen::Vector2d> & deskewed_xy,
+  Pose2D & result_pose)
+{
+  // planar_wall_segments_までの最短距離。process_scanのnearest_segmentと
+  // 同じ計算だが、そちらはprocess_scanのローカルラムダで別スコープのため
+  // ここで独立に持つ(壁配置自体は共有メンバなので計算内容は同一)。
+  const auto nearest_dist = [this](const Eigen::Vector2d & world) {
+      double best_d2 = std::numeric_limits<double>::infinity();
+      for (const auto & segment : planar_wall_segments_) {
+        const Eigen::Vector2d d = segment.b - segment.a;
+        const double len2 = d.squaredNorm();
+        if (len2 <= 1e-12) continue;
+        const double u = std::clamp((world - segment.a).dot(d) / len2, 0.0, 1.0);
+        const Eigen::Vector2d projection = segment.a + u * d;
+        const double d2 = (world - projection).squaredNorm();
+        if (d2 < best_d2) best_d2 = d2;
+      }
+      return std::sqrt(best_d2);
+    };
+
+  // 初期化: 未初期化ならフィールド全体へ一様にばら撒く。
+  if (!particle_filter_active_) {
+    particles_.clear();
+    particles_.reserve(static_cast<size_t>(particle_count_));
+    std::uniform_real_distribution<double> ux(-field_width_ / 2.0, field_width_ / 2.0);
+    std::uniform_real_distribution<double> uy(-field_height_ / 2.0, field_height_ / 2.0);
+    std::uniform_real_distribution<double> uyaw(-M_PI, M_PI);
+    for (int i = 0; i < particle_count_; ++i) {
+      particles_.push_back(Particle{
+        ux(particle_rng_), uy(particle_rng_), uyaw(particle_rng_),
+        1.0 / static_cast<double>(particle_count_)});
+    }
+    particle_filter_active_ = true;
+    particle_prev_odom_valid_ = false;
+    RCLCPP_ERROR(this->get_logger(),
+      "PARTICLE RELOCALIZATION ACTIVATED: scattering %d particles across the field. "
+      "This means self-localization already failed upstream -- treat every activation "
+      "as a bug to root-cause, not as a working recovery path.", particle_count_);
+  }
+
+  // 伝播: 前回スキャンとのオドメトリ差分(ボディ座標系)を全粒子へ適用しノイズを
+  // 注入する。絶対姿勢が間違っていても短時間の相対移動量としては信頼できる、
+  // という標準的なMCLの運動モデル。
+  if (particle_prev_odom_valid_) {
+    const double dyaw = wrap_angle_diff(odom_pose_now.yaw - particle_prev_odom_pose_.yaw);
+    const double dx_world = odom_pose_now.x - particle_prev_odom_pose_.x;
+    const double dy_world = odom_pose_now.y - particle_prev_odom_pose_.y;
+    const double c0 = std::cos(particle_prev_odom_pose_.yaw);
+    const double s0 = std::sin(particle_prev_odom_pose_.yaw);
+    const double dx_body = c0 * dx_world + s0 * dy_world;
+    const double dy_body = -s0 * dx_world + c0 * dy_world;
+    std::normal_distribution<double> noise_xy(0.0, particle_motion_noise_xy_);
+    std::normal_distribution<double> noise_yaw(0.0, particle_motion_noise_yaw_);
+    for (auto & p : particles_) {
+      const double cp = std::cos(p.yaw);
+      const double sp = std::sin(p.yaw);
+      p.x += cp * dx_body - sp * dy_body + noise_xy(particle_rng_);
+      p.y += sp * dx_body + cp * dy_body + noise_xy(particle_rng_);
+      p.yaw = wrap_angle_diff(p.yaw + dyaw + noise_yaw(particle_rng_));
+    }
+  }
+  particle_prev_odom_pose_ = odom_pose_now;
+  particle_prev_odom_valid_ = true;
+
+  // 重み付け: 各粒子の姿勢でdeskewed_xyを変換し、壁までの距離のガウス尤度の
+  // 平均をweightにする。計算コストを抑えるため点を間引く。
+  constexpr size_t kMaxPointsForWeighting = 120;
+  const size_t stride = std::max<size_t>(1, deskewed_xy.size() / kMaxPointsForWeighting);
+  double weight_sum = 0.0;
+  for (auto & p : particles_) {
+    const double c = std::cos(p.yaw);
+    const double s = std::sin(p.yaw);
+    double log_likelihood = 0.0;
+    size_t used = 0;
+    for (size_t i = 0; i < deskewed_xy.size(); i += stride) {
+      const auto & local = deskewed_xy[i];
+      const Eigen::Vector2d world{
+        p.x + c * local.x() - s * local.y(), p.y + s * local.x() + c * local.y()};
+      const double d = nearest_dist(world);
+      log_likelihood -= (d * d) / (2.0 * particle_likelihood_sigma_ * particle_likelihood_sigma_);
+      ++used;
+    }
+    p.weight = used > 0 ? std::exp(log_likelihood / static_cast<double>(used)) : 1e-9;
+    weight_sum += p.weight;
+  }
+  if (weight_sum <= 1e-12) {
+    // 全粒子の尤度が事実上ゼロ(初期スキャッタがことごとく外れた等)。次回に賭ける。
+    return false;
+  }
+  for (auto & p : particles_) {
+    p.weight /= weight_sum;
+  }
+
+  // リサンプリング(systematic resampling)。重みの低い粒子は確率的に淘汰され、
+  // 複数スキャンを重ねるうちに真の姿勢側へ粒子群が寄っていく(はず)。
+  std::vector<Particle> resampled;
+  resampled.reserve(particles_.size());
+  std::uniform_real_distribution<double> u0(0.0, 1.0 / static_cast<double>(particles_.size()));
+  const double start = u0(particle_rng_);
+  double cumulative = particles_.front().weight;
+  size_t idx = 0;
+  for (size_t i = 0; i < particles_.size(); ++i) {
+    const double target = start + static_cast<double>(i) / static_cast<double>(particles_.size());
+    while (cumulative < target && idx + 1 < particles_.size()) {
+      ++idx;
+      cumulative += particles_[idx].weight;
+    }
+    resampled.push_back(Particle{
+      particles_[idx].x, particles_[idx].y, particles_[idx].yaw,
+      1.0 / static_cast<double>(particles_.size())});
+  }
+  particles_ = std::move(resampled);
+
+  // 収束判定: リサンプリング後(重み均一)の粒子群そのものの分散を見る。
+  double mean_x = 0.0, mean_y = 0.0, mean_cos = 0.0, mean_sin = 0.0;
+  for (const auto & p : particles_) {
+    mean_x += p.x;
+    mean_y += p.y;
+    mean_cos += std::cos(p.yaw);
+    mean_sin += std::sin(p.yaw);
+  }
+  const double n = static_cast<double>(particles_.size());
+  mean_x /= n;
+  mean_y /= n;
+  const double mean_yaw = std::atan2(mean_sin / n, mean_cos / n);
+
+  double var_x = 0.0, var_y = 0.0, var_yaw = 0.0;
+  for (const auto & p : particles_) {
+    var_x += (p.x - mean_x) * (p.x - mean_x);
+    var_y += (p.y - mean_y) * (p.y - mean_y);
+    const double dyaw = wrap_angle_diff(p.yaw - mean_yaw);
+    var_yaw += dyaw * dyaw;
+  }
+  const double std_x = std::sqrt(var_x / n);
+  const double std_y = std::sqrt(var_y / n);
+  const double std_yaw = std::sqrt(var_yaw / n);
+
+  if (std_x < particle_converge_xy_std_ && std_y < particle_converge_xy_std_ &&
+    std_yaw < particle_converge_yaw_std_)
+  {
+    result_pose = Pose2D{mean_x, mean_y, mean_yaw, odom_pose_now.stamp_sec};
+    particle_filter_active_ = false;
+    particles_.clear();
+    RCLCPP_ERROR(this->get_logger(),
+      "PARTICLE RELOCALIZATION CONVERGED: (%.3f, %.3f, %.1fdeg). Resuming normal tracking -- "
+      "this recovery working does not excuse root-causing why localization was lost.",
+      mean_x, mean_y, mean_yaw * 180.0 / M_PI);
+    return true;
+  }
+  return false;
+}
