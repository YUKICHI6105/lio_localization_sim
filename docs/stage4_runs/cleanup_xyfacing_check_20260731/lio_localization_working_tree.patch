+  double imu_accel_anomaly_threshold_;  // [m/s^2] 生の加速度ノルムの閾値。この値まで切り詰める
+  uint64_t imu_accel_anomaly_count_ = 0;  // 診断用: 異常検知に入った回数
+  bool is_accel_anomalous(const Eigen::Vector3d & accel) const
+  {
+    return imu_accel_anomaly_enabled_ && accel.norm() > imu_accel_anomaly_threshold_;
