+# matching breaks silently (observed 2026-07-31: "No /odom_fast samples were matched").
+ros2 bag play "$BAG" --clock 250 --rate "$PLAY_RATE" --playback-duration "$PLAYBACK_DURATION" --disable-keyboard-controls \
