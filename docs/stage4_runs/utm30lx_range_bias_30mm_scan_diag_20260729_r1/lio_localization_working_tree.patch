+BackendOptimizerNode::~BackendOptimizerNode()
+{
+  {
+    std::lock_guard<std::mutex> lock(work_mutex_);
+    worker_stop_ = true;
+  }
+  work_cv_.notify_all();
+  if (optimizer_worker_.joinable()) {
+    optimizer_worker_.join();
+  }
+  const double optimizer_overlap_pct = imu_callback_count_ > 0 ?
+    100.0 * static_cast<double>(imu_callbacks_during_optimizer_) /
+    static_cast<double>(imu_callback_count_) : 0.0;
+  const double smoother_overlap_pct = imu_callback_count_ > 0 ?
+    100.0 * static_cast<double>(imu_callbacks_during_smoother_) /
+    static_cast<double>(imu_callback_count_) : 0.0;
+  const double optimizer_mean_ms = optimizer_job_count_ > 0 ?
+    optimizer_job_total_ms_ / static_cast<double>(optimizer_job_count_) : 0.0;
+  const double smoother_mean_ms = smoother_update_count_ > 0 ?
+    smoother_update_total_ms_ / static_cast<double>(smoother_update_count_) : 0.0;
+  RCLCPP_INFO(
+    this->get_logger(),
+    "backend concurrency stats: imu_callbacks=%lu, during_worker=%lu (%.1f%%), "
+    "during_smoother=%lu (%.1f%%), callback_gap_max=%.3fms, gaps>2ms=%lu, "
+    "gaps>10ms=%lu; stamp_gap_max=%.3fms, gaps>1ms=%lu; "
+    "ring_enqueue_max=%.3fms, enqueues>2ms=%lu; callback_duration_max=%.3fms, "
+    "durations>2ms=%lu; worker_jobs=%lu mean/max=%.3f/%.3fms; "
+    "smoother_updates=%lu mean/max=%.3f/%.3fms",
+    static_cast<unsigned long>(imu_callback_count_),
+    static_cast<unsigned long>(imu_callbacks_during_optimizer_), optimizer_overlap_pct,
+    static_cast<unsigned long>(imu_callbacks_during_smoother_), smoother_overlap_pct,
+    max_imu_callback_gap_ms_,
+    static_cast<unsigned long>(imu_callback_gaps_over_2ms_),
